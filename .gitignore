# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Hydra per-run output
train/hydra_outputs/
multirun/

# Large rollout data (regenerable: bash/eval_all_checkpoints.sh)
*.h5
*.hdf5
*.h5.tmp
*.hdf5.tmp

# Model weights (regenerable: bash/train_final_experiment.sh)
*.safetensors
*.ckpt
*.pt
*.pth

# Generated binary feature caches and probe checkpoints live on scratch.
# Keep CSV/JSON summaries, figures, and small empirical sampling audits in Git.
eval/**/features/*.npz
eval/**/probe_models/*.npz
eval/**/probe_splits/*.npz
eval/**/umap_features_*.npz
eval/**/duration_samples.npz

# Generated preallocated schedules: retain JSON parameters/checksums in Git.
# Rebuild with train/rebuild_counterbalanced_schedules.py.
train/run_snapshots/**/schedules/*.npz

# Slurm stdout/stderr — noisy, big; the sbatch_*.txt launch manifests ARE kept.
train/slurm_logs/*.out
train/slurm_logs/*.err
eval/slurm_logs/*.out
eval/slurm_logs/*.err
slurm-*.out
slurm-*.err

# Capability-corpus derived views (JSON layouts + manifest ARE kept)

# W&B
wandb/

# Editor / OS
.vscode/
.idea/
.DS_Store
*.npz
*.csv.gz
